rules_version = '2';

// Profil lengkap hanya bisa dibaca pemiliknya. Pengguna lain hanya melihat publicProfiles
// (nama, email, level, olahraga favorit) untuk mencari lawan chat.
service cloud.firestore {
  match /databases/{database}/documents {
    // Like dapat dibaca setiap pengguna login; hanya pemilik dokumen liker
    // yang boleh menambah atau menghapus like miliknya.
    match /likes/{targetId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /likers/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if isOwner(uid);
      }
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /chatReads/{chatId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isMember(chatId)
          && request.resource.data.keys().hasOnly(['through'])
          && request.resource.data.through is timestamp
          && request.resource.data.through <= request.time
          && (resource == null || request.resource.data.through >= resource.data.through);
      }
    }

    match /activityPosts/{postId} {
      allow read: if isRegistered() && resource.data.published == true;
      allow create: if isRegistered() && validPost(postId, request.resource.data);
      allow update: if isRegistered() && isOwner(resource.data.ownerId)
        && (validPost(postId, request.resource.data)
          || (request.resource.data.published == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published'])));

      match /comments/{commentId} {
        allow read: if isRegistered() && publishedPost(postId);
        allow create: if isRegistered() && publishedPost(postId)
          && validComment(request.resource.data);
      }
    }

    function publishedPost(postId) {
      return get(/databases/$(database)/documents/activityPosts/$(postId)).data.published == true;
    }

    function currentAuthor() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }

    function validPost(postId, data) {
      return data.keys().hasOnly(['ownerId', 'author', 'title', 'description', 'sport',
                                  'startTime', 'movingSeconds', 'distanceMeters', 'published', 'postedAt'])
        && postId.split(':').size() == 2 && postId.split(':')[0] == request.auth.uid
        && isOwner(data.ownerId) && data.author == currentAuthor()
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.description is string && data.description.size() <= 1200
        && data.sport in ['run', 'walk', 'ride', 'hike', 'swim']
        && data.startTime is timestamp
        && data.movingSeconds is int && data.movingSeconds >= 0
        && data.distanceMeters is number && data.distanceMeters >= 0 && data.distanceMeters <= 100000000
        && data.published == true && data.postedAt == request.time;
    }

    function validComment(data) {
      return data.keys().hasOnly(['senderId', 'author', 'text', 'createdAt'])
        && data.senderId == request.auth.uid && data.author == currentAuthor()
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.text.matches('(?s).*[^[:space:]].*')
        && data.createdAt == request.time;
    }

    match /publicProfiles/{uid} {
      allow read: if isRegistered();
      allow create, update: if isRegistered() && isOwner(uid) && validPublicProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /friendships/{pairId} {
      // Anggota dapat membaca pasangan yang belum ada sebelum membuat permintaan.
      allow get: if isRegistered() && request.auth.uid in pairId.split(':');
      allow list: if isRegistered() && request.auth.uid in resource.data.members;
      allow create: if isRegistered() && validFriendRequest(pairId, request.resource.data);
      allow update: if isFriendshipMember()
        && resource.data.senderId != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isFriendshipMember() && resource.data.status == 'pending';
    }

    // ID percakapan = dua uid yang diurutkan lalu digabung dengan '_'
    match /chats/{chatId} {
      allow get: if isMember(chatId);
      allow list: if isRegistered() && request.auth.uid in resource.data.members;
      allow create, update: if isMember(chatId) && validChat(chatId, request.resource.data);

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        // Pesan tidak bisa diubah atau dihapus
        allow create: if isMember(chatId) && validMessage(request.resource.data);
      }
    }

    function isMember(chatId) {
      return isRegistered() && request.auth.uid in chatId.split('_');
    }

    function isRegistered() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isFriendshipMember() {
      return isRegistered() && request.auth.uid in resource.data.members;
    }

    function validFriendRequest(pairId, data) {
      let members = pairId.split(':');
      return data.keys().hasOnly(['members', 'senderId', 'status', 'createdAt'])
        && members.size() == 2 && members[0] < members[1]
        && data.members == members
        && data.senderId == request.auth.uid && request.auth.uid in members
        && data.status == 'pending' && data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(members[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(members[1]));
    }

    function validPublicProfile(data) {
      return data.keys().hasOnly(['name', 'nameLower', 'email', 'level', 'favoriteSports'])
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 50
        && data.nameLower == data.name.lower()
        && data.email == request.auth.token.email.lower()
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.favoriteSports is list;
    }

    function validChat(chatId, data) {
      return data.keys().hasOnly(['members', 'names', 'lastMessage', 'lastSenderId', 'updatedAt'])
        && data.members == chatId.split('_')
        && data.members.size() == 2 && data.members[0] < data.members[1]
        && data.names is map && data.names.keys().hasOnly(data.members)
        && data.lastSenderId == request.auth.uid
        && validText(data.lastMessage)
        && data.updatedAt == request.time;
    }

    function validMessage(data) {
      return data.keys().hasOnly(['senderId', 'text', 'createdAt', 'activityPostId'])
        && data.senderId == request.auth.uid
        && validText(data.text)
        && (!('activityPostId' in data)
          || (data.activityPostId is string && data.activityPostId.matches('[^/]+:[^/]+')
            && publishedPost(data.activityPostId)))
        && data.createdAt == request.time;
    }

    function validText(text) {
      return text is string && text.size() >= 1 && text.size() <= 1000;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'gender', 'birthDate', 'weightKg', 'heightCm',
                                  'level', 'favoriteSports', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 50
        && data.email == request.auth.token.email
        && data.gender in ['male', 'female']
        && data.birthDate is timestamp
        && data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 300
        && data.heightCm is number && data.heightCm >= 100 && data.heightCm <= 250
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.favoriteSports is list && data.favoriteSports.size() >= 1;
    }
  }
}
